<system>
    <domain_schedule>
      <domain name="domain_1" length="100000000" />
      <domain name="domain_2" length="500000000" />
    </domain_schedule>

    <protection_domain name="hello_1" domain="domain_1">
        <program_image path="hello_1.elf" />
    </protection_domain>

    <protection_domain name="hello_2" domain="domain_2">
        <program_image path="hello_2.elf" />
    </protection_domain>

</system>
